# CloudOps Sentinel local configuration
# Copy this file to .env before running docker compose or local services.
# Never commit real credentials. Real AWS access is optional and read-only by default.

NODE_ENV=development
LOG_LEVEL=info

# HTTP
API_PORT=3000
WORKER_METRICS_PORT=9091
DIAGNOSTICS_URL=http://localhost:8000
DIAGNOSTICS_TIMEOUT_MS=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/cloudops
MONGODB_DB_NAME=cloudops

# Auth — demo secret only. Rotate in any non-local environment.
JWT_SECRET=cloudops-sentinel-demo-secret-change-me
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# Demo bootstrap (used by seed script only)
DEMO_PASSWORD=CloudOps!demo
DEFAULT_WORKSPACE_ID=ws_demo_acme
DEFAULT_WORKSPACE_NAME=acme-platform

# Cloud provider: mock | aws
CLOUD_PROVIDER=mock
AWS_REGION=us-east-1
AWS_READ_ONLY=true
ENABLE_AWS_MUTATIONS=false
AWS_MAX_ATTEMPTS=3
AWS_REQUEST_TIMEOUT_MS=4000

# Optional LocalStack
AWS_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# Worker
WORKER_ID=worker-local-1
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_MS=30000
WORKER_HEARTBEAT_MS=8000
WORKER_MAX_ATTEMPTS=5
WORKER_JOB_TIMEOUT_MS=20000
WORKER_BACKOFF_BASE_MS=500
WORKER_BACKOFF_MAX_MS=15000

# Circuit breaker (API → diagnostics)
CB_FAILURE_THRESHOLD=5
CB_RESET_TIMEOUT_MS=15000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Remediation
APPROVAL_TTL_MS=900000
