{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (service, status_code)",
          "legendFormat": "{{service}} {{status_code}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP latency p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, service))",
          "legendFormat": "{{service}} p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, service))",
          "legendFormat": "{{service}} p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, service))",
          "legendFormat": "{{service}} p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Worker queue depth",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "targets": [{ "expr": "worker_queue_depth", "legendFormat": "queue" }]
    },
    {
      "id": 4,
      "title": "Job retries",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "targets": [{ "expr": "sum(job_retries_total)", "legendFormat": "retries" }]
    },
    {
      "id": 5,
      "title": "Dead letters",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 8 },
      "targets": [{ "expr": "sum(job_dead_letter_total)", "legendFormat": "dlq" }]
    },
    {
      "id": 6,
      "title": "Remediation outcomes",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 8 },
      "targets": [
        { "expr": "sum(rate(remediation_success_total[5m]))", "legendFormat": "success" },
        { "expr": "sum(rate(remediation_failure_total[5m]))", "legendFormat": "failure" }
      ]
    },
    {
      "id": 7,
      "title": "Job processing duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(job_processing_duration_seconds_bucket[5m])) by (le, status))",
          "legendFormat": "p95 {{status}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["cloudops", "sre"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "CloudOps Sentinel",
  "uid": "cloudops-sentinel",
  "version": 1
}
